{
  "compilerOptions": {
    /* Visit https://aka.ms/tsconfig to read more about this file */
    
    "esModuleInterop": true,
    // "module": "CommonJS",
    "module": "ES6",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "target": "ES6",
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
