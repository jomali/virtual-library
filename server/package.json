{
  "name": "express-typescript",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "SET NODE_ENV=development & tsx watch src/server",
    "type-check": "tsc",
    "lint": "eslint .",
    "lint:fix": "yarn run lint --fix",
    "build": "rimraf dist && tsc --noEmit false && tsc-alias",
    "start": "node dist/server.js"
  },
